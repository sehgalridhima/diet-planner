# Copy this file to .env.local and paste your key in.
#
#   cp .env.local.example .env.local
#
# .env.local is listed in .gitignore, so it never reaches GitHub.
# This example file has no secret in it and is safe to commit.
#
# Get a key from https://console.anthropic.com → API Keys → Create Key
# (you need credits on the account before any request will work).
#
# Without this key the app still runs — it falls back to the built-in
# planner, which is free and needs no account.

ANTHROPIC_API_KEY=sk-ant-api03-paste-your-key-here

# ---------------------------------------------------------------
# Supabase — only needed for accounts (saved details, /today).
#
# Supabase dashboard → Project Settings → Data API.
# Both of these are safe in the browser: row level security is what
# protects the data, not the secrecy of the anon key.
#
# Without them the app still runs. The anonymous planner works
# exactly as before and the signed-in pages are simply unreachable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=paste-your-anon-key-here
